# Det Store Blå on the Hetzner server (tools/server/setup.sh puts the domain in for @DOMAIN@). Caddy fetches and renews the HTTPS
# certificate itself. The map packs have their hash in the name, so they are cached for a year; the page, the service worker and the
# map's manifest are always checked; the admin page is never cached or indexed.
@DOMAIN@ {
	root * /srv/detstorebla/current
	encode zstd gzip
	# /personvern and /vilkar (the links on Google's sign-in screen) are personvern.html and vilkar.html
	try_files {path} {path}.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
	@packs path_regexp packs ^/map/.+\.wasm$
	header @packs Cache-Control "public, max-age=31536000, immutable"
	@fresh path / /index.html /sw.js /manifest.webmanifest /map/manifest.json
	header @fresh Cache-Control "no-cache"
	@admin path /admin /admin/*
	header @admin {
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow"
	}
}
www.@DOMAIN@ {
	redir https://@DOMAIN@{uri} permanent
}
